# InternConnect AI Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# MongoDB Connection
# Set your MongoDB Atlas or local MongoDB URI below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.cihgnfo.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.cihgnfo.mongodb.net/?appName=Cluster0
DB_NAME=internconnect_ai

# Security & JWT
JWT_SECRET=internconnect_super_secret_jwt_key_2025_ai_portal
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# CORS Settings (for Production / Render deployment)
# Comma-separated list of allowed frontend domains:
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app,https://your-frontend.onrender.com
# Set to true to allow any origin during initial testing:
ALLOW_ALL_ORIGINS=false

# Auto-seed database with initial demo accounts & internships (useful for first-time cloud deployment):
AUTO_SEED=true

